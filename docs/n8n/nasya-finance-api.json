{
  "name": "NASYA Finance API connection",
  "active": false,
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "api-request",
      "name": "Connection check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://<nasya-project-ref>.supabase.co/functions/v1/agent-api",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: $json.action || \"connection.check\", input: $json.input || {}, ...($json.idempotencyKey ? {idempotencyKey: $json.idempotencyKey} : {}) }) }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Manual test": {
      "main": [
        [
          {
            "node": "Connection check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
